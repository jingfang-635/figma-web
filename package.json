{
  "name": "figma-to-fullstack",
  "private": true,
  "scripts": {
    "api": "node scripts/run-with-env.mjs apps/api mvnw.cmd -q spring-boot:run",
    "web": "npm run dev --prefix apps/web",
    "dev:up": "node scripts/dev-up.mjs",
    "build": "cd apps/api && mvnw.cmd -q package && cd ..\\web && npm run build",
    "db:create": "node scripts/create-db.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "visual:layout": "node scripts/extract-layout-ir.mjs",
    "visual:extract": "node scripts/extract-visual-ir.mjs",
    "visual:shots": "node scripts/export-screenshots.mjs",
    "visual:shots:all": "node scripts/export-all-screens.mjs",
    "visual:gen": "node scripts/generate-tokens-css.mjs && node scripts/generate-blueprints.mjs && node scripts/generate-screen-configs.mjs",
    "gen:backend": "node scripts/gen-backend.mjs",
    "visual:assets": "node scripts/export-assets.mjs",
    "visual:capture": "node scripts/capture-screens.mjs",
    "visual:compare": "node scripts/visual-compare.mjs",
    "visual:gate": "node scripts/visual-gate.mjs",
    "visual:stats": "node scripts/field-stats.mjs",
    "visual:all": "node scripts/pipeline-timing.mjs --run=all",
    "pipeline:all": "node scripts/pipeline-timing.mjs --run=all",
    "pipeline:full": "node scripts/pipeline-timing.mjs --run=full",
    "pipeline:round": "node scripts/pipeline-timing.mjs --run=round",
    "init:project": "node scripts/init-project.mjs",
    "visual:doctor": "node scripts/visual-doctor.mjs",
    "visual:bootstrap": "node scripts/visual-bootstrap.mjs",
    "visual:fields": "node scripts/check-field-consistency.mjs",
    "visual:data": "node scripts/check-config-api-closure.mjs && node scripts/check-data-backfill.mjs && node scripts/check-live-data.mjs",
    "visual:geom": "node scripts/check-geometry.mjs",
    "visual:text": "node scripts/check-text.mjs",
    "pipeline:budget": "node scripts/pipeline-timing.mjs --report",
    "docs:lint": "node scripts/check-doc-hardcode.mjs",
    "visual:round": "node scripts/pipeline-timing.mjs --run=round"
  },
  "devDependencies": {
    "pixelmatch": "^5.3.0",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0",
    "ssim.js": "^3.5.0"
  }
}
