{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsg.local/schemas/layout-ir.schema.json",
  "title": "Layout IR",
  "description": "Per-frame geometric intermediate representation extracted from a Figma node subtree. Complements Visual IR tokens; is the source of truth for padding, gap, sizes, and exportable assets.",
  "type": "object",
  "required": ["id", "name", "nodeId", "frame"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "nodeId": { "type": "string" },
    "frame": {
      "type": "object",
      "required": ["w", "h"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" }
      }
    },
    "extractedAt": { "type": "string" },
    "fileKey": { "type": "string" },
    "tokens": { "type": "object" },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "nodeId": { "type": "string" },
          "name": { "type": "string" },
          "box": { "type": "object" },
          "padding": { "type": "array", "items": { "type": "number" } },
          "gap": { "type": "number" },
          "fill": { "type": "string" },
          "font": { "type": "object" },
          "color": { "type": "object" }
        }
      }
    },
    "exportables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nodeId", "kind"],
        "properties": {
          "nodeId": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["nav", "dept", "brand", "chart", "other"] },
          "label": { "type": "string" },
          "w": { "type": "number" },
          "h": { "type": "number" }
        }
      }
    },
    "texts": { "type": "array", "items": { "type": "string" } },
    "tree": { "type": "object" }
  }
}
