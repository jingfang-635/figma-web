{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsg.local/schemas/visual-ir.schema.json",
  "title": "Visual IR",
  "description": "Visual intermediate representation extracted from Figma. Complements App Spec; does not replace entities/APIs.",
  "type": "object",
  "required": ["version", "name", "figma", "tokens", "chrome", "screens", "modals"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "name": { "type": "string" },
    "figma": {
      "type": "object",
      "required": ["fileKey"],
      "properties": {
        "fileKey": { "type": "string" },
        "url": { "type": "string" },
        "extractedAt": { "type": "string" }
      }
    },
    "tokens": {
      "type": "object",
      "required": ["color", "font", "space", "radius", "shadow"],
      "properties": {
        "color": { "type": "object", "additionalProperties": { "type": "string" } },
        "font": {
          "type": "object",
          "properties": {
            "family": { "type": "string" },
            "size": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "space": { "type": "object", "additionalProperties": { "type": ["number", "string"] } },
        "radius": { "type": "object", "additionalProperties": { "type": ["number", "string"] } },
        "shadow": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "chrome": {
      "type": "object",
      "required": ["sidebar", "header"],
      "properties": {
        "sidebar": { "type": "object" },
        "header": { "type": "object" }
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "route", "template"],
        "properties": {
          "name": { "type": "string" },
          "nodeId": { "type": "string" },
          "route": { "type": "string" },
          "template": {
            "type": "string",
            "enum": ["dashboard", "list", "form", "schedule", "content"]
          },
          "resource": { "type": "string" },
          "needsReview": { "type": "boolean" },
          "regions": { "type": "object" }
        }
      }
    },
    "modals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "nodeId": { "type": "string" },
          "kind": { "type": "string", "enum": ["form", "confirm", "warning"] },
          "title": { "type": "string" },
          "message": { "type": "string" },
          "width": { "type": "number" },
          "fields": { "type": "array" },
          "primaryAction": { "type": "string" },
          "secondaryAction": { "type": "string" }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
