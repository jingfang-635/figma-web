# 复制为 .env 后填写；密钥只写 .env，本文件不得含真实值
FIGMA_ACCESS_TOKEN=
FIGMA_API_BASE=https://api.figma.com
# 多项目时显式指定 fixtures/<slug>（单项目可留空）
FIGMA_SLUG=

# 闸门登录凭证（或写在 app-spec.seedAdmin）；localStorage key 取 spec.auth.storageKey
GATE_ADMIN_EMAIL=
GATE_ADMIN_PASSWORD=

LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

JWT_SECRET=change-me-in-dev
JWT_EXPIRES_IN=7d

FIGMA_MCP_ENABLED=true
FIGMA_PLUGIN_EXPORT_DIR=./imports/plugin

# 视觉闸门（可选覆盖）——SSIM 用 ssim.js 标准 MSSIM，阈值语义为「结构崩塌检测」，
# 校准方式：node scripts/visual-gate.mjs --calibrate
WEB_URL=http://localhost:5173
# 还原目标线（像素三腿 AND，经 --calibrate 校准；勿调回旧的宽松值——曾导致闸门静默放行）
VISUAL_SSIM_MIN=0.85
VISUAL_MISMATCH_MAX=0.02
# 低对比度盲区腿：平坦底色漂移（卡片底/容器填充）。mismatch 的 threshold=0.25 对
# <25% 色差不敏感（#FFFFFF vs #F5F7FA ≈3.9%），故需独立判据。校准见 --calibrate
VISUAL_FLATBG_MAX=0.025
VISUAL_FLATBG_MODAL_MAX=0.06
# 宽视口自适应锁定（1440 vs 1888 量同一批 DOM 框）：只许横向铺满，不许纵向重排
VISUAL_WIDE_WIDTH=1888
VISUAL_WIDE_TOL=1.5
VISUAL_FILL_TOL=2
VISUAL_MODAL_CENTER_TOL=2
# 几何闸门（Layout IR 控件框 ↔ DOM 框）：像素三条腿都是全屏统计量，对「尺寸/位置」
# 这类偏差结构性失明（1px 边框位移只影响 ~0.3% 像素），故单列一条几何腿
VISUAL_GEO_TOL=3

# —— 数据库连接信息（复制到 .env 并按本机实际服务填写；生成时只选数据库类型）——
# mysql：Node/Prisma 用 MYSQL_URL，Java/JPA 用 MYSQL_JDBC_URL
MYSQL_URL=
MYSQL_JDBC_URL=
MYSQL_USER=
MYSQL_PASSWORD=
# postgresql：Node/Prisma 用 POSTGRES_URL
POSTGRES_URL=
PG_USER=
PG_PASSWORD=
PG_DB=
# sqlite：仅 Node 栈，无需连接信息（生成时直接写 file:./dev.db）

# 文本闸门：IR TEXT 节点 ↔ DOM 文本盒的允许偏差（px）；字号容差单独一条
VISUAL_TEXT_TOL=3
VISUAL_TEXT_SIZE_TOL=0.6
